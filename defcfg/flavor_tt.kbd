;; TT: Thumb-Taps

(deftemplate hrm_ring   (key) $key)
(deftemplate hrm_middle (key) $key)
(deftemplate hrm_index  (key) $key)

(defalias
  ;; Main mod-tap: Nav layer when held, Space when tapped.
  nav (tap-hold $QUICK_TAP $TAPPING_TERM spc (layer-while-held navigation))

  ;; Space-cadet thumb keys: native behavior when held (Alt/AltGr on PC, Cmd on
  ;; Mac), BackSpace (Del on Nav layers) and Enter when tapped, respectively.
  mod (tap-hold-press $QUICK_TAP $HOLDING_TERM bspc _)
  del (tap-hold-press $QUICK_TAP $HOLDING_TERM del _)
  sym (tap-hold-press $QUICK_TAP $HOLDING_TERM ret (layer-while-held symbols))
)

;; vim: set ft=lisp:
