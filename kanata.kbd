;;==========================================================================;;
;;                                                                          ;;
;;  Pick and choose the features you want for your keyboard:                ;;
;;  angle mod, dual keys, keyboard layout, navigation layer...              ;;
;;                                                                          ;;
;;==========================================================================;;

;; NOTE:
;; If dual keys are enabled (see the "Flavor" section below),
;; this configuration can be live-reloaded with Space+Esc.

;; General settings
(include defcfg/settings.kbd)


;; NOTE:
;;============================================================================
;; Every section below must enable ONE and only one `include` statement:
;;============================================================================
;;  - do not delete or reorder existing sections
;;  - enable each feature by un-commenting the related line
;;    (a commented line starts with ;;)


;;-----------------------------------------------------------------------------
;; Keyboard Geometry
;;-----------------------------------------------------------------------------
;; Pick the configuration matching your keyboard:
;; ISO (a.k.a. 102/105 keys) or ANSI (a.k.a. 101/104 keys).
;; If the key next to the left Shift is `Z`, your keyboard is ANSI.

(include defsrc/iso.kbd)
;; (include defsrc/ansi.kbd)


;;-----------------------------------------------------------------------------
;; Finger Assignment (angle-mod)
;;-----------------------------------------------------------------------------
;; Angle-mods can be enabled here, i.e. ZXCVB can be shifted to the left.
;; More details here: https://colemakmods.github.io/ergonomic-mods/angle.html

(include defsrc/layout.kbd)                ;; standard finger assignment
;; (include defsrc/layout_anglemod.kbd)       ;; ZXCVB are shifted to the left
;; (include defsrc/layout_wide_anglemod.kbd)  ;; angle-mod + right hand shifted by one key


;;-----------------------------------------------------------------------------
;; Flavor (dual keys)
;;-----------------------------------------------------------------------------
;; Dual keys can be enabled here:
;;  - `EZ`: no dual keys
;;    = standard keyboard behavior
;;  - `TT`: thumb-taps
;;    - the right thumb key brings the `Symbols` layer
;;    - a long press on the space bar brings the `Navigation` layer
;;    - a quick tap on the left/right thumb key makes Backspace/Enter
;;  - `HRM`: thumb-taps + home row mods
;;    - the left thumb key becomes Shift
;;    - SDF/JKL become Meta/Ctrl/Alt when held

(include defcfg/flavor_ez.kbd)    ;; standard keyboard behavior
;; (include defcfg/flavor_tt.kbd)    ;; thumb taps
;; (include defcfg/flavor_hrm.kbd)   ;; thumb taps + home row mods


;;-----------------------------------------------------------------------------
;; Host Layout
;;-----------------------------------------------------------------------------
;; The whole `Symbols` layer and some `Navigation` shortcuts depend on the host
;; keyboard layout, i.e. the layout defined in your system settings.
;; Pick your aliases accordingly below.

(include defalias/qwerty.kbd)
;; (include defalias/qwertz.kbd)
;; (include defalias/azerty.kbd)
;; (include defalias/lafayette.kbd)
;; (include defalias/ergol.kbd)
;; (include defalias/bepo.kbd)


;;-----------------------------------------------------------------------------
;; `Base` Layer (and layout emulation)
;;-----------------------------------------------------------------------------
;; The `Base` layer can be either:
;;  - the hardware layout (`base.kbd`)
;;    => your keyboard follows the host layout (= default behavior),
;;       which is defined in your system settings.
;;  - an emulated layout (`base/*.kbd`)
;;    => your keyboard follows this emulated layout instead of the host layout.
;;    /!\ This works perfectly with ASCII layout such as QWERTY ANSI,
;;        but has limitations with non-ASCII layouts.
;;    /!\ Make sure that the expected host layout (e.g. QWERTY, AZERTY)
;;        has been selected in the previous section.

(include deflayer/base.kbd)              ;; no emulation
;; (include deflayer/base/colemak.kbd)      ;; QWERTY to Colemak
;; (include deflayer/base/colemak_dh.kbd)   ;; QWERTY to Colemak-DH
;; (include deflayer/base/dvorak.kbd)       ;; QWERTY to Dvorak
;; (include deflayer/base/ergol.kbd)        ;; AZERTY to Ergo-L
;; (include deflayer/base/lafayette.kbd)    ;; AZERTY to QWERTY-Lafayette


;; NOTE:
;; If dual keys are not enabled (see the "Flavor" section above),
;; the rest of this file can be ignored.


;;-----------------------------------------------------------------------------
;; `Symbols` Layer
;;-----------------------------------------------------------------------------
;; Triggered by Sym (right thumb key).
;;  - by default, brings a Symbols layer
;;  - with the `altgr` variant, the right thumb key becomes AltGr/Option

(include deflayer/symbols.kbd)        ;; programming symbols
;; (include deflayer/symbols_altgr.kbd)  ;; AltGr/Option layer


;;-----------------------------------------------------------------------------
;; `NumLock` Layer
;;-----------------------------------------------------------------------------
;; Enabled by Nav+[P], disabled by [P] or Sym.
;; Similar to the `numpad` layer below, but locked, and without any dual key.

(include deflayer/numlock.kbd)


;;-----------------------------------------------------------------------------
;; `Numbers` Layer
;;-----------------------------------------------------------------------------
;; Triggered by Sym+Shift.

(include deflayer/numpad.kbd)  ;; right-hand numpad, like on the default Navigation layer
;; (include deflayer/numrow.kbd)  ;; numbers on the home row, Shift+numbers on the top row


;;-----------------------------------------------------------------------------
;; `Navigation` Layer
;;-----------------------------------------------------------------------------
;; Triggered by a long press on the spacebar.

(include deflayer/navigation.kbd)      ;; arrows on ESDF, NumPad under the right hand
;; (include deflayer/navigation_vim.kbd)  ;; arrows on HJKL, advanced keys under the left hand


;;-----------------------------------------------------------------------------
;; `Fun/Media` Layer
;;-----------------------------------------------------------------------------
;; Triggered by Nav+Sym.

(include deflayer/funmedia.kbd)

;; vim: set ft=lisp:
