;; Vim-Navigation layer:
;;  - right: Vim-like arrows on HJKL, home/end page up/down, mouse scroll
;;  - left: one-hand shortcuts (Cmd/Ctrl-WASZXCVY), Tab/Shift-Tab, prev/next
;;  - top: function keys

;; The `lrld` action stands for "live reload". This will re-parse everything
;; except for linux-dev, i.e. you cannot live reload and switch keyboard devices.

(deflayer navigation
  f1   f2   f3   f4   f5  lrld  f6   f7   f8   f9   f10  f11  f12
  @lck @cls bck  fwd  XX        home pgdn pgup end  XX
  @all @sav S-tab tab XX        lft  down up   rght XX
  @ndo @cut @cpy @pst @rdo  _   @mwl @mwd @mwu @mwr XX
            del             _             @fun
)

(deflayer numlock
  _    _    _    _    _     _   _    _    _    _    _    _    _
  XX   home up   end  pgup      @/   @7   @8   @9   XX
  XX   lft  down rght pgdn      @-   @4   @5   @6   @0
  XX   XX   XX   XX   XX    _   @,   @1   @2   @3   @.
            @std           @nbs           @std
)

(defalias
  std (layer-switch base)
  lck (layer-switch numlock)

  ;; Mouse wheel emulation
  mwu (mwheel-up    50 120)
  mwd (mwheel-down  50 120)
  mwl (mwheel-left  50 120)
  mwr (mwheel-right 50 120)
)

;; vim: set ft=lisp:
