;; NumRow layer

(deflayer numbers
  _    _    _    _    _     _   _    _    _    _    _    _    _
  @s1  @s2  @s3  @s4  @s5       @s6  @s7  @s8  @s9  @s0  _    _
  @1   @2   @3   @4   @5        @6   @7   @8   @9   @0   _
  @l1  @l2  @l3  @l4  @l5   _   @-   @,   @.   @:   @/
            _              @nbs           @sym
)

