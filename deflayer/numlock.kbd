;; NumLock layer = `NumNav` without function keys or layer-taps.

(deflayer numlock
  @std
  _    _    _    _    _     _   _    _    _    _    _    _    _
  tab  home up   end  pgup  XX  @/   @7   @8   @9   @std _    _
  @all lft  down rght pgdn  XX  @-   @4   @5   @6   @0   _
  @ndo @cut @cpy @pst S-tab _   @,   @1   @2   @3   @.
           sft             spc           @std
)

(defalias
  std (layer-switch base)
  lck (layer-switch numlock)
)

;; vim: set ft=lisp:
