;; NumPad layer

(deflayer numbers
  _    _    _    _    _     _   _    _    _    _    _    _    _
  _    _    _    _    _         @/   @7   @8   @9   XX   _    _
  _    _    _    _    _         @-   @4   @5   @6   @0   _
  _    _    _    _    _     _   @,   @1   @2   @3   @.
            _               _             @sym
)

