;; AltGr layer
;; + access to the Numbers layer

(deflayer symbols
  XX
  AG-1 AG-2 AG-3 AG-4 AG-5  XX  AG-6 AG-7 AG-8 AG-9 AG-0 AG-- AG-=
  AG-q AG-w AG-e AG-r AG-t  XX  AG-y AG-u AG-i AG-o AG-p AG-[ AG-]
  AG-a AG-s AG-d AG-f AG-g  XX  AG-h AG-j AG-k AG-l AG-; @cur
  AG-z AG-x AG-c AG-v AG-b  XX  AG-n AG-m AG-, AG-. AG-/
            @num          AG-spc          _
)

(defalias
  ;; NumRow on hold, Esc on tap
  num (tap-hold-press $QUICK_TAP $HOLDING_TERM esc (layer-while-held numbers))
)

