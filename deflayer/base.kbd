;; Base layer: standard keyboard behavior

(deflayer base
  _
  1    2    3    4    5   bspc  6    7    8    9    0    -    =
  q    w    e    r    t   ret   y    u    i    o    p    [    ]
  a    s    d    f    g    \    h    j    k    l    ;    '
  z    x    c    v    b   lbot  n    m    ,    .    /
            _              _              _
)

(defalias
  sym _  ;; Unreachable but navigation layers needs it to be defined.
)

