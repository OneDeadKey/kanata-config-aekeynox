(defsrc
  esc
  1    2    3    4    5    h    7    8    9    0    -    =    bspc
  q    w    e    r    t    n    u    i    o    p    [    ]    rtop
  a    s    d    f    g    y    j    k    l    ;    '    rmid
  lbot z    x    c    v    b    m    ,    .    /    rsft
        LeftThumb         spc        RightThumb
