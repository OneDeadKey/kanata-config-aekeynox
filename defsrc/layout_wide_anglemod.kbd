;; ┃ ↹      ┃     │     │     │     │     │ \   │     │     │     │     │     │ [   │ ]     │
;; ┣━━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┲━━━━┷━━━━━━━┪
;; ┃         ┃ A   │ S   │ D   │ F   │ G   │   v+│ H   │ J   │ K   │ L   │ :   ┃ "          ┃
;; ┃ ⇬       ┃     │     │     │     │     │ ⌫   │     │     │     │     │ ;   ┃ '          ┃
