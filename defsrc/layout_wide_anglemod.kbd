;; wide-angle-mod:
;; - the bottom-left row is moved one key to the left
;; - the right hand is moved one key to the right
;; - the rightmost column is moved to the center
;;
;; ISO:
;; ┌─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┬─────┲━━━━━━━━━━┓
;; │ ~   │ !   │ @   │ #   │ $   │ %   │     │ ^   │ &   │ *   │ (   │ )   │ _   ┃ +        ┃
;; │ `   │ 1   │ 2   │ 3   │ 4   │ 5   │     │ 6   │ 7   │ 8   │ 9   │ 0   │ -   ┃ =        ┃
;; ┢━━━━━┷━━┱──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┺━━┳━━━━━━━┫
;; ┃        ┃ Q   │ W   │ E   │ R   │ T   │ | v0│ Y   │ U   │ I   │ O   │ P   │ { b-┃ }  b+ ┃
;; ┃ ↹      ┃     │     │     │     │     │ \   │     │     │     │     │     │ [   ┃ ]     ┃
;; ┣━━━━━━━━┻┱────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┴┬────┺┓      ┃
;; ┃         ┃ A   │ S   │ D   │ F   │ G   │   v+│ H   │ J   │ K   │ L   │ :   │ "   ┃      ┃
;; ┃ ⇬       ┃     │     │     │     │     │ ⌫   │     │     │     │     │ ;   │ '   ┃      ┃
;; ┣━━━━━━┳━━┹──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┬──┴──┲━━┷━━━━━┻━━━━━━┫
;; ┃      ┃ Z   │ X   │ C   │ V   │ B   │ |   │   v-│ N   │ M   │ <   │ >   ┃ ?             ┃
;; ┃ ⇧    ┃LBOT │     │     │     │     │ \   │ ⏎   │     │     │ ,   │ .   ┃ /             ┃
;; ┣━━━━━━┻┳━━━━┷━━┳━━┷━━━━┱┴─────┴─────┴─────┴─────┴─────┴─┲━━━┷━━━┳━┷━━━━━╋━━━━━━━┳━━━━━━━┫
;; ┃       ┃       ┃ LTHMB ┃                                ┃ RTHMB ┃       ┃       ┃       ┃
;; ┃ Ctrl  ┃ Meta  ┃ Alt   ┃ ␣                              ┃ AltGr ┃ Meta  ┃ menu  ┃ Ctrl  ┃
;; ┗━━━━━━━┻━━━━━━━┻━━━━━━━┹────────────────────────────────┺━━━━━━━┻━━━━━━━┻━━━━━━━┻━━━━━━━┛
