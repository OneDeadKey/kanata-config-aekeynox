;; wide-angle-mod:
;; - the ISO key (a.k.a. LSGT or 102 key) becomes Z
;; - the right hand is moved one key to the right
;; - [6] becomes Backspace, to preserve the full number row
;;   (along with F1-12 in the Navigation layer)

(defsrc
  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  q    w    e    r    t         u    i    o    p    [
  a    s    d    f    g         j    k    l    ;    '
  lbot z    x    c    v    b    m    ,    .    /    rsft
        LeftThumb         spc        RightThumb
)

;; vim: set ft=lisp:
